Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF (drone frames)
      Enabled: true
      Marker Scale: 1.2
      Show Arrows: false
      Show Axes: true
      Show Names: false   # the monitor labels the drones (FOLLOWER, TARGET)
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Truth (monitor)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /monitor/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Estimate (tracker)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /tracker/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Guidance + safety (follow)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /follow/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Ground radar plots (phase 4)
      Enabled: true
      # The 3-sigma "pancakes" of every plot (+-13 m wide at 500 m) are hidden by default:
      # tick radar_plot_cov in this display to see them.
      Namespaces:
        radar_plots: true
        radar_site: true
        radar_plot_cov: false
      Topic:
        Value: /radar/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera HUD
      Enabled: true
      Normalize Range: true
      Topic:
        Value: /follower/hud_image
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      # The camera follows the follower drone (TF frame from Gazebo, see bridge.yaml).
      # Other views: Views panel -> Type "Orbit" + Target Frame "leader" or "<Fixed Frame>".
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Follow the follower
      Target Frame: follower_truth
      Distance: 20
      Focal Point:
        X: 3
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01
      Pitch: 0.32
      Yaw: 3.14
      Value: ThirdPersonFollower (rviz_default_plugins)
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: World overview
        Distance: 250
        Focal Point:
          X: 100
          Y: 100
          Z: 20
        Pitch: 0.8
        Yaw: 3.9
        Target Frame: <Fixed Frame>
        Value: Orbit (rviz_default_plugins)
      - Class: rviz_default_plugins/ThirdPersonFollower
        Name: Follow the leader
        Target Frame: leader
        Distance: 25
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Pitch: 0.45
        Yaw: 3.14
        Value: ThirdPersonFollower (rviz_default_plugins)
Window Geometry:
  Width: 1400
  Height: 900
  # Dock layout (left column 600 px: camera HUD 16:9 on top, Displays below), generated by
  # tools/rviz_layout.py: RViz stores panel sizes only in this Qt state.
  QMainWindow State: 000000ff00000000fd00000001000000000000025800000384fc0200000002fb0000001400430061006d006500720061002000480055004401000000000000019d0000001700fffffffb000000100044006900730070006c00610079007301000001a3000001e10000001700ffffff0000031a0000038400000004000000040000000800000008fc00000000
  Camera HUD:
    collapsed: false
  Displays:
    collapsed: false
